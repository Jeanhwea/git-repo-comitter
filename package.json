{
  "name": "git-repo-comitter",
  "version": "1.3.2",
  "description": "A CLI tool that uses LLM to generate Git commit messages and execute commits",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/types/lib-browser.d.ts",
      "import": "./dist/browser/index.js"
    }
  },
  "bin": {
    "git-repo-comitter": "dist/cli.cjs",
    "grc": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "fmt": "node scripts/fmt.mjs",
    "ins": "node scripts/ins.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "keywords": [
    "git",
    "commit",
    "llm",
    "ai",
    "openai"
  ],
  "author": "jeanhwea",
  "license": "unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeanhwea/git-repo-comitter.git"
  },
  "bugs": {
    "url": "https://github.com/Jeanhwea/git-repo-comitter/issues"
  },
  "homepage": "https://github.com/Jeanhwea/git-repo-comitter#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "tsc-alias": "^1.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "openai": "^6.46.0"
  }
}
